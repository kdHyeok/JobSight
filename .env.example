POSTGRES_DB=jobsite
POSTGRES_USER=jobsite_app

# 브라우저가 보는 이 서비스의 주소(스킴+호스트+포트). OAuth redirect_uri 를 이 값으로 조립한다.
# Google Cloud Console 의 Authorized redirect URI 는 {PUBLIC_BASE_URL}/login/oauth2/code/google 이다.
# 로컬: http://127.0.0.1:8088   배포: https://job.donyk.link
PUBLIC_BASE_URL=http://127.0.0.1:8088

# 이 이메일의 Google 계정은 로그인할 때마다 ADMIN/ACTIVE 로 보장된다. 본인 Gmail 주소를 넣는다.
APP_ADMIN_EMAIL=you@gmail.com

# Google Cloud Console 의 OAuth 2.0 클라이언트 ID. 비밀이 아니다.
# 클라이언트 시크릿은 .secrets/google_client_secret 파일에 넣는다.
# 둘 중 하나라도 비어 있으면 Google 로그인이 비활성 상태로 기동한다(앱은 정상 기동).
GOOGLE_CLIENT_ID=

# TLS 종단(리버스 프록시) 뒤에서만 true. 로컬 http 에서는 false 여야 쿠키가 동작한다.
# SESSION_COOKIE_SECURE=false
